{
  "name": "markdown-meeting-viewer",
  "version": "1.0.0",
  "private": true,
  "description": "Firefox add-on: read Markdown as clean pages and present it as slides for research group meetings.",
  "author": "Han Nay Aung",
  "license": "MIT",
  "scripts": {
    "start": "web-ext run",
    "lint": "web-ext lint",
    "build": "web-ext build --overwrite-dest",
    "sign": "web-ext sign --channel=listed --approval-timeout=0",
    "update-libs": "sh scripts/update-libs.sh",
    "check-version": "node scripts/check-version.mjs"
  },
  "devDependencies": {
    "web-ext": "^10.7.0"
  }
}
